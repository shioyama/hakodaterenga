#!/bin/bash

# Local development server for Jekyll site
# Outputs to a separate _site_dev directory to avoid overwriting production builds

echo "🚀 Starting local development server..."
echo "   Site will be available at http://localhost:4000"
echo "   Output directory: _site_dev (separate from production _site)"
echo "   Press Ctrl+C to stop"
echo ""

# Use a different destination directory for development
bundle exec jekyll serve --destination _site_dev --config _config.yml,_config_dev.yml